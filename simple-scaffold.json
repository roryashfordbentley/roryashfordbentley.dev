{
  "component": {
    "templates": [
      ".component-template/{{name}}.tsx",
      ".component-template/{{name}}.stories.tsx",
      ".component-template/{{name}}.module.css"
    ],
    "output": "src/components/{{name}}"
  },
  "block": {
    "templates": [".block-template/Component.tsx", ".block-template/Schema.tsx"],
    "output": "src/blocks/{{name}}"
  }
}
