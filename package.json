{
  "name": "rab-website",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "dev-storybook": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo & storybook dev -p 6006 --ci",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "serve-storybook": "serve storybook-static",
    "create-component": "npx simple-scaffold -c simple-scaffold.json -k component $1",
    "create-block": "npx simple-scaffold -c simple-scaffold.json -k block $1",
    "prepare": "husky",
    "postinstall": "npm rebuild sharp --force"
  },
  "dependencies": {
    "@atproto/api": "^0.14.9",
    "@heroicons/react": "^2.2.0",
    "@payloadcms/db-mongodb": "^3.43.0",
    "@payloadcms/live-preview-react": "^3.43.0",
    "@payloadcms/next": "^3.43.0",
    "@payloadcms/richtext-lexical": "^3.43.0",
    "@payloadcms/storage-uploadthing": "^3.43.0",
    "cross-env": "^7.0.3",
    "embla-carousel-react": "^8.5.2",
    "embla-carousel-wheel-gestures": "^8.0.2",
    "graphql": "^16.8.1",
    "isomorphic-dompurify": "^2.22.0",
    "next": "^16.0.0",
    "payload": "^3.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-syntax-highlighter": "^15.6.1",
    "refractor": "^5.0.0",
    "sharp": "0.32.6",
    "sugar-high": "^0.9.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@csstools/postcss-global-data": "^3.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@storybook/addon-docs": "^9.0.13",
    "@storybook/nextjs": "^9.0.13",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.5.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ajv": "^8.17.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.5",
    "eslint-plugin-storybook": "9.0.13",
    "husky": "^9.1.7",
    "postcss-custom-media": "^11.0.5",
    "postcss-nesting": "^13.0.1",
    "postcss-rem": "^3.0.0",
    "prettier": "^3.4.2",
    "storybook": "^9.0.13",
    "storybook-design-token": "^4.1.0",
    "typescript": "5.7.3",
    "vitest": "^3.0.6"
  }
}
