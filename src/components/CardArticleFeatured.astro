---
import "@styles/global.css";
const urlPrefix = "/posts/";

const { title, description, date, url } = Astro.props;

/**
 * dateFormatter
 *
 * Create appropriate date strings for the <time> element.
 * Returns both human and machine readable values.
 */
function dateFormat(date: Date) {
	const dateFormatted = new Date(date);

	new Date(date).toString();

	const [month, day, year] = [date.getMonth(), date.getDate(), date.getFullYear()];

	let readableDateString = `${day}/${month + 1} — ${year}`;
	let machineReadableDateString = dateFormatted.toISOString();

	return { readableDateString, machineReadableDateString };
}
---

<div class="card-article-featured">
	<div class="card-article-featured__meta">
		<div class="card-article-featured__meta-item">
			<h3 class="card-article-featured__subtitle">Posted:</h3>

			<time
				class="card-article-featured__date"
				datetime={dateFormat(date).machineReadableDateString}
			>
				{dateFormat(date).readableDateString}
			</time>
		</div>

		<div class="card-article-featured__meta-item">
			<div class="card-article-featured__tags">
				<h3 class="card-article-featured__subtitle">Tags:</h3>
				<span class="card-article-featured__tag">WordPress</span>
			</div>
		</div>
	</div>
	<div class="card-article-featured__content">
		<h2 class="card-article-featured__title">
			<a class="card-article-featured__link" href={url}>{title}</a>
		</h2>

		<p class="card-article-featured__description">
			{description}
		</p>
	</div>
</div>

<style>
	.card-article-featured {
		display: flex;
		width: 100%;
	}

	.card-article-featured__content {
		width: 75%;
	}

	.card-article-featured__title {
		font-size: clamp(var(--font-size-4), 3vw, var(--font-size-9));
		margin-bottom: var(--spacing-5);
	}

	.card-article-featured__link {
	}

	.card-article-featured__description {
		font-size: clamp(var(--font-size-2), 2vw, var(--font-size-5));
		margin-bottom: var(--spacing-5);
	}

	.card-article-featured__meta {
		display: flex;
		flex-direction: column;
		flex: 1 0;
	}

	.card-article-featured__meta-item {
	}

	.card-article-featured__subtitle {
		display: block;
		color: var(--theme-text-tint);
		font-size: var(--font-size-3);
	}

	.card-article-featured__date {
	}
</style>
