---
import "../styles/tokens/colours.css";
import "../styles/tokens/fonts.css";
import "../styles/tokens/spacing.css";

const { items } = Astro.props;
---

<div class="wrapper">
	<div class="wrapper__content">
		<slot />
	</div>
</div>

<!-- Have to use is:global to style ancestor links in Astro :( -->
<style>
	.wrapper {
		display: grid;
		grid-template-columns: auto clamp(350px, 80%, 1200px) auto;
		grid-auto-flow: row;
	}

	.wrapper__content {
		grid-column: 2/3 !important;
	}
</style>
