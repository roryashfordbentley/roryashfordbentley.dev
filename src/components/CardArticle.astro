---
import "@styles/global.css";
import dateFormatter from "@scripts/date-formatter.ts";
import { Image } from "astro:assets";

const urlPrefix = "/posts/";

const { title, description, date, url, image_src, image_alt } = Astro.props;
---

<div class="card-article">
	<figure class="card-article__figure">
		{
			image_src && (
				<Image
					src={image_src}
					alt={image_alt}
					layout="responsive"
					width={800}
					height={450}
				/>
			)
		}
	</figure>

	<time class="card-article__date" datetime={dateFormatter(date).machineReadableDateString}>
		{dateFormatter(date).readableDateString}
	</time>

	<h2 class="card-article__title">
		<a class="card-article__link" href={url}>{title}</a>
	</h2>
</div>

<style>
	.card-article {
		width: 100%;
	}

	.card-article__image {
		border-radius: var(--radius-2);
		margin-bottom: var(--spacing-5);
	}

	.card-article__date {
		display: block;
		margin-bottom: var(--spacing-5);
	}

	.card-article__title {
		font-size: clamp(var(--font-size-4), 3vw, var(--font-size-6));
		font-weight: var(--font-weight-extra-bold);
	}

	.card-article__link {
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}

	.card-article__description {
		font-size: clamp(var(--font-size-2), 2vw, var(--font-size-3));
		margin-bottom: var(--spacing-5);
	}
</style>
