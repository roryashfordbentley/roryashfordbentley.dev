---
import "../styles/global.css";
const urlPrefix = "/posts/";

const { title, description, date, url } = Astro.props;

/**
 * dateFormatter
 *
 * Create appropriate date strings for the <time> element.
 * Returns both human and machine readable values.
 */
function dateFormat(date: Date) {
	const dateFormatted = new Date(date);

	new Date(date).toString();

	const [month, day, year] = [
		date.getMonth(),
		date.getDate(),
		date.getFullYear(),
	];

	let readableDateString = `${month}/${day}—${year}`;
	let machineReadableDateString = dateFormatted.toISOString();

	return { readableDateString, machineReadableDateString };
}
---

<div class="card-article">
	<h2 class="card-article__title">
		<a class="card-article__link" href={url}>{title}</a>
	</h2>

	<div class="card-article__description">
		{description}
	</div>

	<div class="card-article__meta">
		<div class="card-article__meta-item">
			<h3 class="card-article__subtitle">Posted:</h3>
			<time
				class="card-article__date"
				datetime={dateFormat(date).machineReadableDateString}
			>
				{dateFormat(date).readableDateString}
			</time>
		</div>
		<div class="card-article__meta-item">
			<div class="card-article__tags">
				<h3 class="card-article__subtitle">Tags:</h3>
				<span class="card-article__tag">WordPress</span>
			</div>
		</div>
	</div>
</div>

<style>
	.card-article {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		width: 100%;
	}

	.card-article__title {
		font-size: clamp(var(--font-size-4), 3vw, var(--font-size-6));
		margin-bottom: var(--spacing-5);
	}

	.card-article__link {
	}

	.card-article__description {
		font-size: clamp(var(--font-size-2), 2vw, var(--font-size-3));
		margin-bottom: var(--spacing-5);
	}

	.card-article__meta {
		display: flex;
		width: 100%;
		justify-content: flex-start;
		align-items: flex-start;
		margin-top: auto;
	}

	.card-article__meta-item {
		width: 50%;
	}

	.card-article__subtitle {
		display: block;
		color: var(--theme-text-tint);
		font-size: var(--font-size-3);
	}

	.card-article__date {
	}
</style>
