---
import config from "../content/config/config.json";
import LogoLink from "./LogoLink.astro";
import MainNav from "./MainNav.astro";
import ThemeToggle from "./ThemeToggle.astro";

import "@styles/tokens/colours.css";
import "@styles/tokens/spacing.css";

//const options = await client.queries.options({ relativePath: "index.json" });
const logo = config.logo;
---

<header class="site-header">
	<div class="site-header__inner">
		<div class="site-header__logo">
			<LogoLink link="/" />
		</div>

		<div class="site-header__nav">
			<MainNav />
		</div>

		<div class="site-header__toggle">
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		/*border-bottom: 1px solid var(--theme-border);*/
	}

	.site-header__inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--spacing-8) 0 var(--spacing-5) 0;
	}

	.site-header__logo {
		width: 5rem;
	}

	.site-header__nav {
		margin-left: auto;
		margin-right: var(--spacing-5);
	}
</style>
