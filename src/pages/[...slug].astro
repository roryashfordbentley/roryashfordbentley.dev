---
import { getCollection } from "astro:content";
import client from "@tina/__generated__/client";
import PageLayout from "@layouts/PageLayout.astro";

import { tinaField, useTina } from "tinacms/dist/react";

import { Blocks } from "@blocks/_BlocksLoader";

export async function getStaticPaths() {
	const page = await getCollection("page");

	return page.map((p) => ({
		params: { slug: p.id },
		props: {
			getTinaProps: async () =>
				client.queries.page({
					relativePath: p.data.tinaInfo.relativePath,
				}),
		},
	}));
}

const { getTinaProps } = Astro.props;
const pageData = await getTinaProps();
---

<PageLayout>
	<Blocks {...page.data} client:tina />
</PageLayout>
