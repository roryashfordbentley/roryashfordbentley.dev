---
import PageLayout from "@layouts/PageLayout.astro";
import client from "@tina/__generated__/client";
import { BlocksLoader } from "@blocks/_BlocksLoader";
import { getCollection } from "astro:content";
import { BlogGrid } from "@components/BlogGrid";
import CardArticle from "@components/CardArticle.astro";
import { GridLayout } from "@components/GridLayout";
import { GridLayoutItem } from "@components/GridLayout";

const data = await client.queries.page({ relativePath: "blog.mdx" });

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageLayout>
	<BlocksLoader {...data} client:tina />

	<GridLayout>
		<GridLayoutItem>
			<BlogGrid>
				{
					posts.map((post) => (
						<CardArticle
							image_src={post.data.featuredImage}
							image_alt="alt txt"
							title={post.data.title}
							description={post.data.description}
							date={post.data.pubDate}
							url={`/blog/${post.id}/`}
						/>
					))
				}
			</BlogGrid>
		</GridLayoutItem>
	</GridLayout>
</PageLayout>
